{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echo-training-developer",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "kv_namespaces": [{ "binding": "SCANS" }],
  "vars": {
    "PUBLIC_APP_URL": "https://yuto01ota-arch.github.io/echo_training-App/",
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1062501",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
